filters:
  and:
    - type == "task"
    - status != "Archived"
properties:
  note.status:
    displayName: Status
  note.project:
    displayName: Project
  note.assignee:
    displayName: Assignee
  note.description:
    displayName: Description
views:
  - type: tm-kanban
    name: Pipeline
    groupBy:
      property: status
      direction: ASC
    order:
      - project
      - assignee
      - description
    sort:
      - property: priority
        direction: ASC
    usePredefinedColumns: true
    predefinedValues:
      - Backlog|#D3D1C7
      - Todo|#B5D4F4
      - In Progress|#FAC775
      - Blocked|#F7C1C1
      - Done|#C0DD97
      - Cancelled|#F5C4B3
    doneStatuses:
      - Done
    archiveValue: Archived

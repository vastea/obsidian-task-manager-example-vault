filters:
  and:
    - type == "task"
    - status != "Archived"
properties:
  note.status:
    displayName: Status
  note.assignee:
    displayName: Assignee
  note.priority:
    displayName: Priority
  note.description:
    displayName: Description
views:
  - type: tm-kanban
    name: Alpha
    filters:
      and:
        - project == "Alpha"
    groupBy:
      property: status
      direction: ASC
    order:
      - assignee
      - priority
      - description
    sort:
      - property: priority
        direction: ASC
    usePredefinedColumns: true
    predefinedValues:
      - Backlog|#D3D1C7
      - Todo|#B5D4F4
      - In Progress|#FAC775
      - Blocked|#F7C1C1
      - Done|#C0DD97
      - Cancelled|#F5C4B3
    doneStatuses:
      - Done
    archiveValue: Archived
  - type: tm-kanban
    name: Beta
    filters:
      and:
        - project == "Beta"
    groupBy:
      property: status
      direction: ASC
    order:
      - assignee
      - priority
      - description
    usePredefinedColumns: true
    predefinedValues:
      - Backlog|#D3D1C7
      - Todo|#B5D4F4
      - In Progress|#FAC775
      - Blocked|#F7C1C1
      - Done|#C0DD97
      - Cancelled|#F5C4B3
    doneStatuses:
      - Done
    archiveValue: Archived
  - type: tm-kanban
    name: Gamma
    filters:
      and:
        - project == "Gamma"
    groupBy:
      property: status
      direction: ASC
    order:
      - assignee
      - priority
      - description
    usePredefinedColumns: true
    predefinedValues:
      - Backlog|#D3D1C7
      - Todo|#B5D4F4
      - In Progress|#FAC775
      - Blocked|#F7C1C1
      - Done|#C0DD97
      - Cancelled|#F5C4B3
    doneStatuses:
      - Done
    archiveValue: Archived
  - type: tm-kanban
    name: Personal
    filters:
      and:
        - project == "Personal"
    groupBy:
      property: status
      direction: ASC
    order:
      - priority
      - description
    usePredefinedColumns: true
    predefinedValues:
      - Backlog|#D3D1C7
      - Todo|#B5D4F4
      - In Progress|#FAC775
      - Blocked|#F7C1C1
      - Done|#C0DD97
      - Cancelled|#F5C4B3
    doneStatuses:
      - Done
    archiveValue: Archived
